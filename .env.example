# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PayMongo Configuration (Subscription Billing)
# The PayMongo SECRET key must never live here (VITE_ vars are public).
# Set it as an Edge Function secret: npx supabase secrets set PAYMONGO_SECRET_KEY=sk_...

# Cloudflare Turnstile (human check on sign in, sign up and password reset). The SITE key is public.
# The SECRET key goes only in Supabase: Authentication > Attack Protection. Leave blank to turn the check off.
VITE_TURNSTILE_SITE_KEY=

# Application URL (for payment redirects)
VITE_APP_URL=http://localhost:5173

# Build/Environment
MODE=development

# Supabase Edge Functions — Gmail SMTP (set in Supabase dashboard, not in frontend)
# GMAIL_USER=yourpersonalemail@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
