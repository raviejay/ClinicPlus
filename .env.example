# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PayMongo Configuration (Subscription Billing)
# Get these from: https://dashboard.paymongo.com/developers/api_keys
VITE_PAYMONGO_SECRET_KEY=sk_live_your_secret_key_here
VITE_PAYMONGO_PUBLIC_KEY=pk_live_your_public_key_here

# Application URL (for payment redirects)
VITE_APP_URL=http://localhost:5173

# Build/Environment
MODE=development

# Supabase Edge Functions — Gmail SMTP (set in Supabase dashboard, not in frontend)
# GMAIL_USER=yourpersonalemail@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
